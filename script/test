#!/bin/bash
#
# script/test
#
# Functional tests for the scripts that have non-trivial logic:
# stow-package (conflict parsing + backup moves) and setup-git-config
# (Git-native rendering, migration, and drift detection). Each test runs
# inside its own mktemp sandbox with a stubbed $HOME; nothing touches the real
# system.
#
# The runner does NOT use `set -e` globally so that a failing assertion
# in one test reports and continues instead of aborting the whole suite.
# Individual test functions set `set -e` locally so a bare `[ ... ]` or
# command failure aborts just that test with a nonzero exit code, which
# run_test translates into a FAIL.

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    NC=''
fi

passed=0
failed=0

run_test() {
    local name=$1
    local fn=$2
    local sandbox
    sandbox=$(mktemp -d)
    local output
    if output=$("$fn" "$sandbox" 2>&1); then
        printf "  ${GREEN}PASS${NC} %s\n" "$name"
        passed=$((passed + 1))
    else
        printf "  ${RED}FAIL${NC} %s\n" "$name"
        if [ -n "$output" ]; then
            printf '%s\n' "$output" | sed 's/^/    /'
        fi
        failed=$((failed + 1))
    fi
    rm -rf "$sandbox"
}

# ------- stow-package -------
#
# The sandbox layout mirrors the real repo just enough for stow-package's
# `$(dirname "$0")/..` resolution: we copy the script into
# $sandbox/repo/script/ and build a fake package next to it. Invoking
# $sandbox/repo/script/stow-package makes REPO_ROOT resolve to
# $sandbox/repo, so `pkg` is looked up inside the sandbox, not the real
# dotfiles checkout.

make_stow_sandbox_repo() {
    local sandbox=$1
    mkdir -p "$sandbox/repo/script"
    cp "$REPO_ROOT/script/stow-package" "$sandbox/repo/script/"
}

test_stow_clean() {
    local sandbox=$1
    set -e
    make_stow_sandbox_repo "$sandbox"
    mkdir -p "$sandbox/repo/pkg/.config" "$sandbox/home"
    echo "repo-content" > "$sandbox/repo/pkg/.config/foo.conf"

    HOME="$sandbox/home" "$sandbox/repo/script/stow-package" pkg > /dev/null

    [ -L "$sandbox/home/.config/foo.conf" ] || { echo "expected symlink"; exit 1; }
    [ ! -d "$sandbox/home/.dotfiles-backup" ] || { echo "backup dir should not exist"; exit 1; }
}

test_stow_real_file_conflict() {
    local sandbox=$1
    set -e
    make_stow_sandbox_repo "$sandbox"
    mkdir -p "$sandbox/repo/pkg/.config" "$sandbox/home/.config"
    echo "repo-content" > "$sandbox/repo/pkg/.config/foo.conf"
    echo "original-home-content" > "$sandbox/home/.config/foo.conf"

    HOME="$sandbox/home" "$sandbox/repo/script/stow-package" pkg > /dev/null

    [ -L "$sandbox/home/.config/foo.conf" ] || { echo "expected symlink after stow"; exit 1; }

    local backup
    backup=$(find "$sandbox/home/.dotfiles-backup" -name foo.conf -print -quit 2>/dev/null)
    [ -n "$backup" ] || { echo "no backup file found"; exit 1; }
    [ "$(cat "$backup")" = "original-home-content" ] \
        || { echo "backup contents not preserved"; exit 1; }
}

test_stow_foreign_symlink_conflict() {
    local sandbox=$1
    set -e
    make_stow_sandbox_repo "$sandbox"
    mkdir -p "$sandbox/repo/pkg/.config" "$sandbox/home/.config" "$sandbox/other"
    echo "repo-content" > "$sandbox/repo/pkg/.config/foo.conf"
    echo "foreign" > "$sandbox/other/foreign-target"
    ln -s "$sandbox/other/foreign-target" "$sandbox/home/.config/foo.conf"

    HOME="$sandbox/home" "$sandbox/repo/script/stow-package" pkg > /dev/null

    [ -L "$sandbox/home/.config/foo.conf" ] || { echo "expected symlink"; exit 1; }
    local target
    target=$(readlink "$sandbox/home/.config/foo.conf")
    case "$target" in
        */repo/pkg/.config/foo.conf) ;;
        *) echo "symlink points to wrong target: $target"; exit 1 ;;
    esac
    find "$sandbox/home/.dotfiles-backup" -name foo.conf 2>/dev/null | grep -q . \
        || { echo "foreign symlink not backed up"; exit 1; }
}

test_stow_foreign_directory_symlink_conflict() {
    local sandbox=$1
    set -e
    make_stow_sandbox_repo "$sandbox"
    mkdir -p "$sandbox/repo/pkg/.config/demo" \
	"$sandbox/home" \
	"$sandbox/other/config/demo"
    echo "repo-content" > "$sandbox/repo/pkg/.config/demo/foo.conf"
    echo "foreign-content" > "$sandbox/other/config/demo/foreign.conf"
    ln -s "$sandbox/other/config" "$sandbox/home/.config"

    HOME="$sandbox/home" "$sandbox/repo/script/stow-package" pkg > /dev/null

    [ -d "$sandbox/home/.config" ] && [ ! -L "$sandbox/home/.config" ] \
	|| { echo "foreign directory symlink was not replaced"; exit 1; }
    [ -L "$sandbox/home/.config/demo/foo.conf" ] \
	|| { echo "package file was not stowed"; exit 1; }
    [ -f "$sandbox/other/config/demo/foreign.conf" ] \
	|| { echo "foreign directory contents were changed"; exit 1; }
    find "$sandbox/home/.dotfiles-backup" -type l -name .config 2>/dev/null | grep -q . \
	|| { echo "foreign directory symlink not backed up"; exit 1; }
}

test_stow_mixed_conflicts_and_clean() {
    local sandbox=$1
    set -e
    make_stow_sandbox_repo "$sandbox"
    mkdir -p "$sandbox/repo/pkg/.config/nested" "$sandbox/home/.config/nested"
    echo "a" > "$sandbox/repo/pkg/.config/a.conf"
    echo "b" > "$sandbox/repo/pkg/.config/nested/b.conf"
    echo "c" > "$sandbox/repo/pkg/.config/nested/c.conf"
    echo "home-b" > "$sandbox/home/.config/nested/b.conf"

    HOME="$sandbox/home" "$sandbox/repo/script/stow-package" pkg > /dev/null

    [ -L "$sandbox/home/.config/a.conf" ]          || { echo "a not symlinked"; exit 1; }
    [ -L "$sandbox/home/.config/nested/b.conf" ]   || { echo "b not symlinked"; exit 1; }
    [ -L "$sandbox/home/.config/nested/c.conf" ]   || { echo "c not symlinked"; exit 1; }

    find "$sandbox/home/.dotfiles-backup" -name b.conf 2>/dev/null | grep -q . \
        || { echo "b.conf should be in backup"; exit 1; }
    if find "$sandbox/home/.dotfiles-backup" -name a.conf 2>/dev/null | grep -q .; then
        echo "a.conf should not be in backup"; exit 1
    fi
    if find "$sandbox/home/.dotfiles-backup" -name c.conf 2>/dev/null | grep -q .; then
        echo "c.conf should not be in backup"; exit 1
    fi
}

test_stow_restow_is_idempotent() {
    local sandbox=$1
    set -e
    make_stow_sandbox_repo "$sandbox"
    mkdir -p "$sandbox/repo/pkg/.config" "$sandbox/home"
    echo "repo-content" > "$sandbox/repo/pkg/.config/foo.conf"

    HOME="$sandbox/home" "$sandbox/repo/script/stow-package" pkg > /dev/null
    # Second run: the target is already the symlink we would create, so it
    # must not be treated as a conflict and moved into the backup dir.
    HOME="$sandbox/home" "$sandbox/repo/script/stow-package" pkg > /dev/null

    [ -L "$sandbox/home/.config/foo.conf" ] || { echo "expected symlink"; exit 1; }
    [ "$(cat "$sandbox/home/.config/foo.conf")" = "repo-content" ] \
        || { echo "symlink no longer resolves to package content"; exit 1; }
    [ ! -d "$sandbox/home/.dotfiles-backup" ] \
        || { echo "re-stow should not back anything up"; exit 1; }
}

test_stow_restow_prunes_obsolete_link() {
    local sandbox=$1
    set -e
    make_stow_sandbox_repo "$sandbox"
    mkdir -p "$sandbox/repo/pkg/.config" "$sandbox/home"
    echo "keep" > "$sandbox/repo/pkg/.config/keep.conf"
    echo "remove" > "$sandbox/repo/pkg/.config/remove.conf"

    HOME="$sandbox/home" "$sandbox/repo/script/stow-package" pkg > /dev/null
    rm "$sandbox/repo/pkg/.config/remove.conf"
    HOME="$sandbox/home" "$sandbox/repo/script/stow-package" pkg > /dev/null

    [ -L "$sandbox/home/.config/keep.conf" ] || { echo "current link missing"; exit 1; }
    [ ! -e "$sandbox/home/.config/remove.conf" ] \
	&& [ ! -L "$sandbox/home/.config/remove.conf" ] \
	|| { echo "obsolete link was not pruned"; exit 1; }
}

test_stow_restow_unfolds_owned_directory() {
    local sandbox=$1
    set -e
    make_stow_sandbox_repo "$sandbox"
    mkdir -p "$sandbox/repo/pkg/.config/demo" "$sandbox/home"
    echo "repo-content" > "$sandbox/repo/pkg/.config/demo/foo.conf"

    (
	cd "$sandbox/repo"
	stow -t "$sandbox/home" pkg
    )
    [ -L "$sandbox/home/.config" ] || { echo "fixture did not fold directory"; exit 1; }

    HOME="$sandbox/home" "$sandbox/repo/script/stow-package" pkg > /dev/null

    [ -d "$sandbox/home/.config" ] && [ ! -L "$sandbox/home/.config" ] \
	|| { echo "owned directory symlink was not unfolded"; exit 1; }
    [ -L "$sandbox/home/.config/demo/foo.conf" ] \
	|| { echo "package file was not restowed"; exit 1; }
    [ ! -d "$sandbox/home/.dotfiles-backup" ] \
	|| { echo "owned directory symlink should not be backed up"; exit 1; }
}

test_stow_local_ignore_runtime_state() {
    local sandbox=$1
    set -e
    make_stow_sandbox_repo "$sandbox"
    mkdir -p "$sandbox/repo/pkg/.config/nvim" "$sandbox/home/.config/nvim"
    cp "$REPO_ROOT/common/.stow-local-ignore" "$sandbox/repo/pkg/"
    echo "pkg/.config/nvim/lazy-lock.json" > "$sandbox/repo/.gitignore"
    (
	cd "$sandbox/repo"
	git init -q
    )
    echo "tracked" > "$sandbox/repo/pkg/.config/nvim/init.lua"
    echo "source-runtime" > "$sandbox/repo/pkg/.config/nvim/lazy-lock.json"
    echo "host-runtime" > "$sandbox/home/.config/nvim/lazy-lock.json"

    HOME="$sandbox/home" "$sandbox/repo/script/stow-package" pkg > /dev/null

    [ -L "$sandbox/home/.config/nvim/init.lua" ] || { echo "tracked file not stowed"; exit 1; }
    [ ! -L "$sandbox/home/.config/nvim/lazy-lock.json" ] \
	|| { echo "runtime file should not be linked"; exit 1; }
    [ "$(cat "$sandbox/home/.config/nvim/lazy-lock.json")" = "host-runtime" ] \
	|| { echo "host runtime file was not preserved"; exit 1; }
    [ ! -d "$sandbox/home/.dotfiles-backup" ] \
	|| { echo "ignored runtime file should not be backed up"; exit 1; }
}

test_stow_dangling_symlink_conflict() {
    local sandbox=$1
    set -e
    make_stow_sandbox_repo "$sandbox"
    mkdir -p "$sandbox/repo/pkg/.config" "$sandbox/home/.config"
    echo "repo-content" > "$sandbox/repo/pkg/.config/foo.conf"
    # A link to a target that does not exist: `test -e` is false for this,
    # so it is only detectable via -L.
    ln -s "$sandbox/nowhere/gone.conf" "$sandbox/home/.config/foo.conf"

    HOME="$sandbox/home" "$sandbox/repo/script/stow-package" pkg > /dev/null

    [ "$(cat "$sandbox/home/.config/foo.conf")" = "repo-content" ] \
        || { echo "dangling link was not replaced by the package symlink"; exit 1; }
    find "$sandbox/home/.dotfiles-backup" -name foo.conf 2>/dev/null | grep -q . \
        || { echo "dangling symlink not backed up"; exit 1; }
}

test_stow_missing_arg() {
    local sandbox=$1
    if "$REPO_ROOT/script/stow-package" 2>/dev/null; then
        echo "expected nonzero exit for missing arg"
        exit 1
    fi
}

test_stow_nonexistent_package() {
    local sandbox=$1
    set -e
    make_stow_sandbox_repo "$sandbox"
    if HOME="$sandbox/home" "$sandbox/repo/script/stow-package" nonexistent 2>/dev/null; then
        echo "expected nonzero exit for missing package"
        exit 1
    fi
}

# ------- setup-git-config -------
#
# setup-git-config hardcodes its template path relative to $REPO_ROOT
# (via $(dirname "$0")/..), so we invoke the real script from the real
# repo but stub $HOME so the identity and rendered config live in the
# sandbox. This tests the real template rendering end-to-end.

write_test_identity() {
    local home=$1 email=$2 key=$3
    local identity="$home/.config/local/git/identity.gitconfig"
    mkdir -p "$(dirname "$identity")"
    git config --file "$identity" user.email "$email"
    git config --file "$identity" user.signingkey "$key"
}

test_git_config_basic_render() {
    local sandbox=$1
    set -e
    write_test_identity "$sandbox/home" "test@example.com" "ABCD1234DEADBEEF"

    HOME="$sandbox/home" "$REPO_ROOT/script/setup-git-config" > /dev/null

    local config="$sandbox/home/.config/git/config"
    [ -f "$config" ] || { echo "config not rendered"; exit 1; }
    [ "$(git config --file "$config" --get user.email)" = "test@example.com" ] \
	|| { echo "email not injected"; exit 1; }
    [ "$(git config --file "$config" --get user.signingkey)" = "ABCD1234DEADBEEF" ] \
	|| { echo "signing key not injected"; exit 1; }
}

test_git_config_special_values() {
    local sandbox=$1
    set -e
    local email='weird&chars|here\test@example.com'
    local key='KEY&BAD|ID\WITHBACKSLASH'
    write_test_identity "$sandbox/home" "$email" "$key"

    HOME="$sandbox/home" "$REPO_ROOT/script/setup-git-config" > /dev/null

    local config="$sandbox/home/.config/git/config"
    [ "$(git config --file "$config" --get user.email)" = "$email" ] \
	|| { echo "email value did not round trip"; exit 1; }
    [ "$(git config --file "$config" --get user.signingkey)" = "$key" ] \
	|| { echo "signing key value did not round trip"; exit 1; }
}

test_git_config_codespaces_skip() {
    local sandbox=$1
    set -e
    mkdir -p "$sandbox/home"
    CODESPACES=1 HOME="$sandbox/home" "$REPO_ROOT/script/setup-git-config" > /dev/null
    [ -f "$sandbox/home/.config/git/config" ] \
        || { echo "codespaces path should render config"; exit 1; }
    local config="$sandbox/home/.config/git/config"
    if git config --file "$config" --get-regexp '^user\.' >/dev/null; then
	echo "[user] section should be removed"
	exit 1
    fi
    if git config --file "$config" --get-regexp '^include\.' >/dev/null; then
	echo "[include] section should be removed"
	exit 1
    fi
    [ "$(git config --file "$config" --get commit.gpgsign)" = "false" ] \
        || { echo "gpgsign should be false in codespaces mode"; exit 1; }
    git config --file "$config" --get alias.co >/dev/null \
        || { echo "aliases should be present in codespaces config"; exit 1; }
}

test_git_config_missing_email() {
    local sandbox=$1
    set -e
    mkdir -p "$sandbox/home/.config/local/git"
    git config --file "$sandbox/home/.config/local/git/identity.gitconfig" user.signingkey xxx
    if HOME="$sandbox/home" "$REPO_ROOT/script/setup-git-config" 2>/dev/null; then
	echo "expected nonzero exit when user.email missing"
        exit 1
    fi
}

test_git_config_missing_signingkey() {
    local sandbox=$1
    set -e
    mkdir -p "$sandbox/home/.config/local/git"
    git config --file "$sandbox/home/.config/local/git/identity.gitconfig" user.email x@y.z
    if HOME="$sandbox/home" "$REPO_ROOT/script/setup-git-config" 2>/dev/null; then
	echo "expected nonzero exit when user.signingkey missing"
	exit 1
    fi
}

test_git_config_legacy_identity_migration() {
    local sandbox=$1
    set -e
    mkdir -p "$sandbox/home/.config/dotfiles"
    cat > "$sandbox/home/.config/dotfiles/identity.env" <<'EOF'
EMAIL=legacy@example.com
SIGNINGKEY=LEGACY1234
EOF

    HOME="$sandbox/home" "$REPO_ROOT/script/setup-git-config" > /dev/null

    local identity="$sandbox/home/.config/local/git/identity.gitconfig"
    [ -f "$identity" ] || { echo "legacy identity was not migrated"; exit 1; }
    [ "$(git config --file "$identity" --get user.email)" = "legacy@example.com" ] \
	|| { echo "migrated email is incorrect"; exit 1; }
    [ "$(git config --file "$identity" --get user.signingkey)" = "LEGACY1234" ] \
	|| { echo "migrated signing key is incorrect"; exit 1; }
    [ -f "$sandbox/home/.config/local/git/identity.env.migrated" ] \
	|| { echo "legacy identity should be archived"; exit 1; }
    [ ! -e "$sandbox/home/.config/dotfiles/identity.env" ] \
	|| { echo "legacy identity should leave the old directory"; exit 1; }
}

test_git_config_prior_git_identity_migration() {
    local sandbox=$1
    set -e
    local old_identity="$sandbox/home/.config/dotfiles/identity.gitconfig"
    mkdir -p "$(dirname "$old_identity")"
    git config --file "$old_identity" user.email prior@example.com
    git config --file "$old_identity" user.signingkey PRIOR1234

    HOME="$sandbox/home" "$REPO_ROOT/script/setup-git-config" > /dev/null

    local identity="$sandbox/home/.config/local/git/identity.gitconfig"
    [ "$(git config --file "$identity" --get user.email)" = "prior@example.com" ] \
	|| { echo "prior Git identity email is incorrect"; exit 1; }
    [ "$(git config --file "$identity" --get user.signingkey)" = "PRIOR1234" ] \
	|| { echo "prior Git identity signing key is incorrect"; exit 1; }
    [ ! -e "$old_identity" ] || { echo "prior Git identity should be moved"; exit 1; }
}

test_git_config_check_detects_drift() {
    local sandbox=$1
    set -e
    write_test_identity "$sandbox/home" "test@example.com" "ABCD1234"
    HOME="$sandbox/home" "$REPO_ROOT/script/setup-git-config" > /dev/null
    HOME="$sandbox/home" "$REPO_ROOT/script/setup-git-config" --check

    git config --file "$sandbox/home/.config/git/config" alias.drift true
    if HOME="$sandbox/home" "$REPO_ROOT/script/setup-git-config" --check; then
	echo "expected drift check to fail"
        exit 1
    fi
}

# ------- tool_ready -------
#
# tool_ready lives in install-codespace-tools. With a version-flag probe it
# must return true only when a tool is both on PATH and actually executes —
# a binary present but broken (e.g. glibc mismatch, exits nonzero) must be
# treated as not runnable so the installer rebuilds it. With the "none"
# probe it checks presence only (tools without a version flag).

extract_tool_ready_fn() {
    local sandbox=$1
    sed -n '/^tool_ready()/,/^}/p' "$REPO_ROOT/script/install-codespace-tools" \
        > "$sandbox/tool_ready_fn.sh"
}

test_tool_ready_working() {
    local sandbox=$1
    set -e
    extract_tool_ready_fn "$sandbox"
    mkdir -p "$sandbox/bin"
    cat > "$sandbox/bin/faketool" <<'STUB'
#!/bin/bash
echo "faketool 1.2.3"
STUB
    chmod +x "$sandbox/bin/faketool"
    # shellcheck disable=SC1091,SC2030,SC2031
    ( PATH="$sandbox/bin:$PATH"; source "$sandbox/tool_ready_fn.sh"; tool_ready faketool --version )
}

test_tool_ready_broken() {
    local sandbox=$1
    set -e
    extract_tool_ready_fn "$sandbox"
    mkdir -p "$sandbox/bin"
    # Present on PATH but crashes at runtime, like a glibc mismatch.
    cat > "$sandbox/bin/faketool" <<'STUB'
#!/bin/bash
echo "faketool: version \`GLIBC_2.35' not found" >&2
exit 1
STUB
    chmod +x "$sandbox/bin/faketool"
    # shellcheck disable=SC1091,SC2030,SC2031
    if ( PATH="$sandbox/bin:$PATH"; source "$sandbox/tool_ready_fn.sh"; tool_ready faketool --version ); then
        echo "a broken binary should not be reported as ready"
        exit 1
    fi
}

test_tool_ready_absent() {
    local sandbox=$1
    set -e
    extract_tool_ready_fn "$sandbox"
    # Empty PATH dir: the tool is not present at all.
    mkdir -p "$sandbox/bin"
    # shellcheck disable=SC1091,SC2030,SC2031
    if ( PATH="$sandbox/bin"; source "$sandbox/tool_ready_fn.sh"; tool_ready faketool --version ); then
        echo "an absent tool should not be reported as ready"
        exit 1
    fi
}

test_tool_ready_none_present() {
    local sandbox=$1
    set -e
    extract_tool_ready_fn "$sandbox"
    mkdir -p "$sandbox/bin"
    # A tool with no version flag: "none" probe checks presence only, so a
    # binary that errors on --version is still considered ready.
    cat > "$sandbox/bin/faketool" <<'STUB'
#!/bin/bash
echo "usage: faketool ..." >&2
exit 1
STUB
    chmod +x "$sandbox/bin/faketool"
    # shellcheck disable=SC1091,SC2030,SC2031
    ( PATH="$sandbox/bin:$PATH"; source "$sandbox/tool_ready_fn.sh"; tool_ready faketool none )
}

test_tool_ready_none_absent() {
    local sandbox=$1
    set -e
    extract_tool_ready_fn "$sandbox"
    mkdir -p "$sandbox/bin"
    # shellcheck disable=SC1091,SC2030,SC2031
    if ( PATH="$sandbox/bin"; source "$sandbox/tool_ready_fn.sh"; tool_ready faketool none ); then
        echo "an absent tool should not be reported as ready (none probe)"
        exit 1
    fi
}

# ------- runner -------

echo "=== stow-package ==="
run_test "clean stow, no conflicts"         test_stow_clean
run_test "real file conflict"               test_stow_real_file_conflict
run_test "foreign symlink conflict"         test_stow_foreign_symlink_conflict
run_test "foreign directory symlink"        test_stow_foreign_directory_symlink_conflict
run_test "mixed conflicts and clean files"  test_stow_mixed_conflicts_and_clean
run_test "re-stow is idempotent"            test_stow_restow_is_idempotent
run_test "re-stow prunes obsolete link"      test_stow_restow_prunes_obsolete_link
run_test "re-stow unfolds owned directory"  test_stow_restow_unfolds_owned_directory
run_test "runtime state is ignored"          test_stow_local_ignore_runtime_state
run_test "dangling symlink conflict"         test_stow_dangling_symlink_conflict
run_test "missing arg errors"               test_stow_missing_arg
run_test "nonexistent package errors"       test_stow_nonexistent_package

echo
echo "=== setup-git-config ==="
run_test "basic template render"            test_git_config_basic_render
run_test "special values round trip"        test_git_config_special_values
run_test "codespaces render"                test_git_config_codespaces_skip
run_test "missing user.email errors"        test_git_config_missing_email
run_test "missing signing key errors"       test_git_config_missing_signingkey
run_test "legacy identity migration"        test_git_config_legacy_identity_migration
run_test "prior Git identity migration"     test_git_config_prior_git_identity_migration
run_test "drift check"                      test_git_config_check_detects_drift

echo
echo "=== tool_ready ==="
run_test "working tool ready"               test_tool_ready_working
run_test "broken tool (glibc) not ready"    test_tool_ready_broken
run_test "absent tool not ready"            test_tool_ready_absent
run_test "none probe: present is ready"     test_tool_ready_none_present
run_test "none probe: absent not ready"     test_tool_ready_none_absent

echo
printf "${GREEN}passed: %d${NC}  ${RED}failed: %d${NC}\n" "$passed" "$failed"
[ "$failed" -eq 0 ]
