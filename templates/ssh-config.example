# Copy to ~/.ssh/config.d/<name> (for example ~/.ssh/config.d/work).
# ssh uses the first value it finds, so these files override the shared Host * block.
#
# Host devbox
# 	HostName devbox.example.com
# 	User me
# 	IdentityFile ~/.ssh/devbox.pub
# 	IdentitiesOnly yes

# OrbStack (work Mac only): put this line in ~/.ssh/config.d/orbstack.
#
# Include ~/.orbstack/ssh/config

# vim: ft=sshconfig
